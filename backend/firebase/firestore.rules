rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    function isAuthenticated() {
      return request.auth != null;
    }

    function isAdmin() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isRescueTeam() {
      return isAuthenticated() &&
        get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'rescue_team';
    }

    function isOwner(uid) {
      return isAuthenticated() && request.auth.uid == uid;
    }

    match /users/{uid} {
      allow read: if isAuthenticated();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /emergencies/{emergencyId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    // Per-SOS contact-notification delivery records.
    match /emergency_alerts/{alertId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /medical_profiles/{uid} {
      allow read: if isOwner(uid) || isAdmin() || isRescueTeam();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /rescue_teams/{teamId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /ambulances/{ambulanceId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /drones/{droneId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    match /hospitals/{hospitalId} {
      allow read: if isAuthenticated();
      // Authenticated clients (mobile app) may publish GPS-discovered hospitals.
      allow write: if isAuthenticated();
    }

    match /hospital_alerts/{alertId} {
      allow read: if isAuthenticated();
      allow create, update: if isAuthenticated();
      allow delete: if isAdmin();
    }

    match /drone_logs/{droneId} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }

    // Per-user notification feed.
    match /notifications/{uid}/{notifId} {
      allow read: if isOwner(uid) || isAdmin();
      allow write: if isOwner(uid) || isAdmin();
    }

    match /activity_logs/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /bluetooth_signals/{signalId} {
      allow read: if isAuthenticated();
      allow write: if isAuthenticated();
    }

    match /incident_history/{logId} {
      allow read: if isAuthenticated();
      allow create: if isAuthenticated();
      allow update, delete: if isAdmin();
    }

    match /analytics/{doc} {
      allow read: if isAuthenticated();
      allow write: if isAdmin();
    }
  }
}
